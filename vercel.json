{
  "redirects": [
    {
      "source": "/properties",
      "destination": "https://book.lazybee.sg",
      "statusCode": 301
    },
    {
      "source": "/property/:id*",
      "destination": "https://book.lazybee.sg",
      "statusCode": 301
    },
    {
      "source": "/book",
      "destination": "https://book.lazybee.sg",
      "statusCode": 301
    },
    {
      "source": "/book/:path*",
      "destination": "https://book.lazybee.sg/:path*",
      "statusCode": 301
    },
    {
      "source": "/view/:path*",
      "destination": "https://book.lazybee.sg",
      "statusCode": 301
    },
    {
      "source": "/hive/topic/numbers",
      "destination": "/hive/topic/costs",
      "statusCode": 301
    },
    {
      "source": "/hive/topic/market",
      "destination": "/hive/topic/operators",
      "statusCode": 301
    },
    {
      "source": "/hive/topic/tenants",
      "destination": "/hive",
      "statusCode": 301
    },
    {
      "source": "/hive/topic/money",
      "destination": "/hive/topic/costs",
      "statusCode": 301
    },
    {
      "source": "/hive/what-a-room-actually-costs",
      "destination": "/hive/whats-included-in-coliving-rent-singapore",
      "statusCode": 301
    },
    {
      "source": "/hive/why-three-months-not-twelve",
      "destination": "/hive/ura-minimum-stay-breach-fines",
      "statusCode": 301
    },
    {
      "source": "/hive/three-homes-nineteen-rooms",
      "destination": "/hive/chiltern-park-ivory-heights-thomson-grove-guide",
      "statusCode": 301
    },
    {
      "source": "/blog/:slug",
      "destination": "/hive/:slug",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/hive",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/leads/close",
      "destination": "/api/booking/lead-close"
    },
    {
      "source": "/api/owners/lead",
      "destination": "/api/booking/owner-lead"
    },
    {
      "source": "/api/v1",
      "destination": "/api/v1/_index"
    },
    {
      "source": "/api/v1/:s1/:s2/:s3",
      "destination": "/api/v1/:s1?_seg2=:s2&_seg3=:s3"
    },
    {
      "source": "/api/v1/:s1/:s2",
      "destination": "/api/v1/:s1?_seg2=:s2"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/faqs",
      "destination": "/faqs/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service/index.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookie-policy/index.html"
    },
    {
      "source": "/((?!api/|pitchv1).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/booking/cron",
      "schedule": "0 12 * * *"
    }
  ]
}
